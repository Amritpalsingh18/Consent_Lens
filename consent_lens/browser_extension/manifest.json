{
  "manifest_version": 3,
  "name": "CONSENT LENS",
  "version": "2.0.0",
  "description": "Website permission insights, activity history, and privacy reminders.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "contentSettings"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CONSENT LENS",
    "default_popup": "popup.html"
  }
}